{
  "name": "@bifravst/cloudformation-helpers",
  "version": "0.0.0-development",
  "description": "Helper functions which simplify working with AWS CloudFormation stacks",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test ./src/*.spec.ts",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "npx tsc --noEmit false --outDir ./dist -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/cloudformation-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/cloudformation-helpers/issues"
  },
  "homepage": "https://github.com/bifravst/cloudformation-helpers",
  "keywords": [
    "nrf-asset-tracker",
    "iot"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@aws-sdk/client-cloudformation": ">= 3 < 4"
  },
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "8.0.3",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "26.4.0",
    "check-node-version": "4.2.1",
    "husky": "9.1.7",
    "nock": "14.0.17"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@bifravst/from-env": "4.0.0"
  }
}
